#!/usr/bin/env bash
#
# claude-box-dotnet — manage the generic Claude Code .NET dev container for a project.
#
#   claude-box-dotnet start   [PROJECT_DIR]   create (first time) or start the container
#   claude-box-dotnet stop    [PROJECT_DIR]   stop the running container
#   claude-box-dotnet info    [PROJECT_DIR]   show status/details for the container
#
# Manages containers only; the image is built by the sibling build-image script.
#
# PROJECT_DIR defaults to the current directory and is bind-mounted at /workspace.
# The container name is derived deterministically from the project's absolute path
# (claude-dotnet-<dir>-<hash>), so `stop`/`info` need no saved state — they recompute
# the same name from the directory. The image must already exist; build it with
# the sibling build-image script.
#
# You CAN run several projects at once: each container gets its own auto-assigned
# host port, so they never clash. Claude auth/config is shared (one login), while
# Claude session history (~/.claude/projects) and shell history are per project —
# every project mounts at /workspace, so without a per-project history volume they
# would all collide into the same "-workspace" session bucket.
#
# Env overrides:
#   IMAGE         image tag to use/build      (default: claude-dotnet-devcontainer:latest)
#   PORT          fixed host port -> :8080     (default: auto-assigned, conflict-free)
#   DB_CONNECTION_STRING  external SQL Server, SqlClient format, injected as
#                 ConnectionStrings__Default   (default: host.docker.internal)
#   CONTAINER_USER  non-root user inside the image (default: vscode)
#   PROJECT_CODE_NAME  label shown in the container's shell prompt in place of the
#                 username (default: the project directory's basename)
#   CLAUDE_ORG    optional prefix for the secret vars below (CLAUDE_ORG=acme ->
#                 ACME_CLAUDE_TOKEN_OP_REF); unset means use the plain names
#
# Secrets are never stored in this repo or baked into the image; they are resolved
# on the HOST at start time and injected into the running container. Each is looked
# up under the CLAUDE_ORG-prefixed name first, then the plain one:
#   CLAUDE_TOKEN_OP_REF      1Password ref for a long-lived Claude OAuth token
#   DOCKER_SSH_KEY_OP_REF    1Password ref for the remote Docker host's SSH key
#   OP_SERVICE_ACCOUNT_TOKEN service-account token so `op` runs non-interactively
#                            (the prefixed form may also be named <CLAUDE_ORG>_1P_TOKEN)
#   DOCKER_SSH_KEY           the SSH key material directly, skipping the provider
#
# Alternative to 1Password: openssl-encrypted files. Pick the provider with
# `claude-box-dotnet provider openssl` (for the current project; add --user for the
# per-user default in ~/.config/claude-box/config; SECRET_PROVIDER overrides per run), create the files with
# `claude-box-dotnet seal token` / `seal ssh-key FILE`, and `start` prompts for the
# passphrase when it needs a secret. Optional overrides:
#   CLAUDE_TOKEN_FILE, DOCKER_SSH_KEY_FILE   paths (also CLAUDE_ORG-prefixed)
#   CLAUDE_SECRETS_PASSPHRASE_FILE / CLAUDE_SECRETS_PASSPHRASE   skip the prompt
#   CLAUDE_BOX_CONFIG_DIR    config/secrets dir (default ~/.config/claude-box)
#
set -euo pipefail

IMAGE="${IMAGE:-claude-dotnet-devcontainer:latest}"
DB_CONNECTION_STRING="${DB_CONNECTION_STRING:-Server=host.docker.internal,1433;Database=app;User Id=sa;Password=Your_strong_Passw0rd;TrustServerCertificate=True}"

# The non-root user baked into the image (see the Dockerfile's USERNAME arg).
CONTAINER_USER="${CONTAINER_USER:-vscode}"

# Remote Docker host — the isolated VM where Claude builds/runs/tests containers.
# These are non-secret (LAN IP + username), hardcoded as defaults but overridable
# via env. DOCKER_HOST is assembled so `docker`/`docker compose` inside the
# container run against the remote daemon over SSH, using the key that
# resolve_ssh_key injects at start time.
REMOTE_DOCKER_USER="${REMOTE_DOCKER_USER:-dockerizer}"
REMOTE_DOCKER_HOST="${REMOTE_DOCKER_HOST:-192.168.122.10}"

# Optional namespace for the secret env vars, so several orgs/tenants can coexist
# in one shell without their references colliding. With CLAUDE_ORG=acme, this
# script looks for ACME_CLAUDE_TOKEN_OP_REF before falling back to the unprefixed
# CLAUDE_TOKEN_OP_REF. Leave it unset and only the plain names are used.
CLAUDE_ORG="$(printf '%s' "${CLAUDE_ORG:-}" | tr '[:lower:]' '[:upper:]' | tr -c 'A-Z0-9_' '_')"

# Claude persists its login (auth, credentials, settings) in ~/.claude, backed by
# this named volume. It MUST be namespaced by CLAUDE_ORG: without that, an
# org-scoped token would still be written into — and on a later start read back
# out of — one credentials store shared by every container on the machine, which
# is exactly the cross-org mix-up the prefix is meant to prevent. Unset
# CLAUDE_ORG keeps the original volume name, so existing setups keep their login.
CONFIG_VOLUME="claude-code-config${CLAUDE_ORG:+-$(printf '%s' "$CLAUDE_ORG" | tr '[:upper:]' '[:lower:]')}"

# Where this script REALLY lives, following symlinks. The Docker build context is
# the .devcontainer/ next to the real script, and the helper is normally invoked
# through a symlink on PATH (see HOWTO step 2) — without resolving the link we'd
# look for the Dockerfile next to the LINK and the build would fail. `readlink -f`
# does this in one step but is GNU-only, so walk the chain by hand for macOS.
SCRIPT_SRC="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_SRC" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SRC")" && pwd)"
  SCRIPT_SRC="$(readlink "$SCRIPT_SRC")"
  case "$SCRIPT_SRC" in
    /*) ;;                              # absolute target: use as-is
    *) SCRIPT_SRC="$SCRIPT_DIR/$SCRIPT_SRC" ;;   # relative: resolve against the link's dir
  esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SRC")" && pwd)"

# --- helpers ----------------------------------------------------------------

usage() {
  cat >&2 <<EOF
Usage: claude-box-dotnet <command> [PROJECT_DIR]

Commands:
  start   [DIR]   Create (first time) or start the container for DIR (default: cwd)
  stop    [DIR]   Stop the running container for DIR
  rm      [DIR]   Stop and remove the container for DIR (fresh start next time)
  shell   [DIR]   Open an interactive bash shell inside DIR's container
  info    [DIR]   Show status and details for DIR's container
  provider [NAME|unset] [DIR | --user]
                  Show the effective secrets provider, or set it (1password | openssl)
                  for a project; --user sets the per-user default instead
  seal    token [DIR] | ssh-key FILE [DIR | --user]
                  Create an openssl-encrypted secret file (for the openssl provider):
                  per project; the SSH key can also be a per-user default (--user)

PROJECT_DIR defaults to the current directory.
EOF
  exit "${1:-2}"
}

# Prefix a variable name with CLAUDE_ORG when one is set: "FOO" -> "ACME_FOO",
# or plain "FOO" when CLAUDE_ORG is empty.
org_var() { printf '%s%s' "${CLAUDE_ORG:+${CLAUDE_ORG}_}" "$1"; }

# Print the value of the first variable in the argument list that is set and
# non-empty; return 1 if none are. This is what lets every secret be looked up
# under an org-prefixed name first and a generic name second. Names that aren't
# valid shell identifiers are skipped rather than fatal — indirect expansion of
# e.g. "1P_TOKEN" (leading digit) would otherwise abort the script under `set -e`.
first_env() {
  local name
  for name in "$@"; do
    case "$name" in
      '' | [0-9]*) continue ;;
    esac
    if [ -n "${!name:-}" ]; then
      printf '%s' "${!name}"
      return 0
    fi
  done
  return 1
}

# The 1Password service-account token, so `op` can read secrets non-interactively.
# Prefixed form keeps the historical _1P_TOKEN suffix; unprefixed we fall back to
# OP_SERVICE_ACCOUNT_TOKEN, which is 1Password's own standard variable — if you
# already export that for the `op` CLI, this script needs no extra configuration.
op_service_token() {
  first_env "$(org_var 1P_TOKEN)" "$(org_var OP_SERVICE_ACCOUNT_TOKEN)" \
            OP_SERVICE_ACCOUNT_TOKEN || true
}

# Building the image is a MAINTAINER task owned entirely by this sibling script.
# claude-box-dotnet never invokes it — we only name it so a missing image can point you
# at the right tool.
BUILD_SCRIPT="$SCRIPT_DIR/build-image"

# Compute WORKSPACE / HASH / NAME / PROJECT_CODE_NAME from an optional directory
# argument.
#
# PROJECT_CODE_NAME is the project directory's basename, injected into the
# container so its bash prompt reads "<code-name> ➜ /workspace (branch) $" instead
# of "<user> ➜ ...". Every project mounts at the same /workspace, so the username
# and the path are identical in every container — the code name is the only thing
# in the prompt that says WHICH project a terminal is attached to. Overridable from
# the shell for directories whose name is unhelpful (src, app, repo).
resolve_target() {
  [ -d "${1:-$PWD}" ] || { echo "ERROR: not a directory: ${1:-$PWD}" >&2; exit 1; }
  WORKSPACE="$(cd "${1:-$PWD}" && pwd)"
  HASH="$(printf '%s' "$WORKSPACE" | cksum | cut -d' ' -f1)"
  NAME="claude-dotnet-$(basename "$WORKSPACE")-${HASH}"
  PROJECT_CODE_NAME="${PROJECT_CODE_NAME:-$(basename "$WORKSPACE")}"
}

# Read one secret from 1Password and print it. Args: <op:// reference>.
# Returns non-zero (printing nothing) if `op` is missing or the read fails; every
# caller treats that as "carry on without it" rather than a fatal error.
op_read() {
  local ref="$1"
  command -v op >/dev/null 2>&1 || return 1
  OP_SERVICE_ACCOUNT_TOKEN="$(op_service_token)" op read "$ref" 2>/dev/null
}

# --- secret providers ---------------------------------------------------------
# Secrets come from ONE provider, chosen per user (never per repo):
#   1password  `op read` of an op:// reference (the default)
#   openssl    a file encrypted with `openssl enc` (create it with `seal`)
# Selection: $SECRET_PROVIDER, else SECRET_PROVIDER= in the config file below,
# else 1password. There is no silent fallback between providers.
CONFIG_DIR="${CLAUDE_BOX_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-box}"
CONFIG_FILE="$CONFIG_DIR/config"
OPENSSL_ARGS=(enc -aes-256-cbc -pbkdf2 -iter 600000 -salt -pass env:OPENSSL_PASS)

# Read KEY from a config file (default: the per-user one). Parsed as plain KEY=VALUE
# lines, never sourced, so the file can't run code. Args: <KEY> [FILE]
config_get() {
  local file="${2:-$CONFIG_FILE}" v
  [ -f "$file" ] || return 1
  v="$(sed -n "s/^$1=//p" "$file" | tail -n1)"
  [ -n "$v" ] || return 1
  printf '%s' "$v"
}

# Sets PROVIDER and PROVIDER_SOURCE (not via $(...), so a bad value can abort the
# script). Most specific wins: $SECRET_PROVIDER, then this project's setting (needs
# resolve_target to have run), then the per-user default, then 1password.
load_provider() {
  PROVIDER="${SECRET_PROVIDER:-}"
  PROVIDER_SOURCE="the SECRET_PROVIDER environment variable"
  if [ -z "$PROVIDER" ] && [ -n "${NAME:-}" ]; then
    PROVIDER="$(config_get SECRET_PROVIDER "$(project_config_file)" || true)"
    PROVIDER_SOURCE="this project ($(project_config_file))"
  fi
  if [ -z "$PROVIDER" ]; then
    PROVIDER="$(config_get SECRET_PROVIDER || true)"
    PROVIDER_SOURCE="the per-user default ($CONFIG_FILE)"
  fi
  if [ -z "$PROVIDER" ]; then
    PROVIDER=1password
    PROVIDER_SOURCE="the built-in default"
  fi
  PROVIDER="$(printf '%s' "$PROVIDER" | tr '[:upper:]' '[:lower:]')"
  case "$PROVIDER" in
    1password|openssl) ;;
    *) echo "ERROR: unknown SECRET_PROVIDER '$PROVIDER' (use 1password or openssl)." >&2
       exit 1 ;;
  esac
}

# The Docker-host SSH key: per project first, then a per-user default shared by
# every project that has none of its own. DOCKER_SSH_KEY_FILE (also
# CLAUDE_ORG-prefixed) is an explicit path override.
ssh_key_project_file() { printf '%s/docker-ssh-key.enc' "$(project_secret_dir)"; }
ssh_key_user_file() { printf '%s/docker-ssh-key.enc' "$CONFIG_DIR"; }
ssh_key_file() {
  local f
  f="$(first_env "$(org_var DOCKER_SSH_KEY_FILE)" DOCKER_SSH_KEY_FILE || true)"
  if [ -z "$f" ]; then
    f="$(ssh_key_project_file)"
    [ -f "$f" ] || f="$(ssh_key_user_file)"
  fi
  printf '%s' "$f"
}

# Each project has its own Claude Code token (several Claude accounts can coexist),
# kept OUTSIDE the project directory — the project is bind-mounted into the
# container, so a file there would be visible to it. Keyed by the same name the
# container uses, so it is per project and never in any repo.
project_secret_dir() { printf '%s/projects/%s' "$CONFIG_DIR" "$NAME"; }

# This project's own settings file (currently just SECRET_PROVIDER), kept next to its
# secrets and outside the project directory for the same reason.
project_config_file() { printf '%s/config' "$(project_secret_dir)"; }

# The token file for the current project AND organization (resolve_target must have
# run): claude-token-<org>.enc, so one project can switch between several Claude
# accounts by switching CLAUDE_ORG. Prints nothing and returns 1 when CLAUDE_ORG is
# unset, because the org is part of the name. CLAUDE_TOKEN_FILE (also
# CLAUDE_ORG-prefixed) is an explicit path override that needs no org.
token_file() {
  local f
  f="$(first_env "$(org_var CLAUDE_TOKEN_FILE)" CLAUDE_TOKEN_FILE || true)"
  if [ -z "$f" ]; then
    [ -n "$CLAUDE_ORG" ] || return 1
    f="$(project_secret_dir)/claude-token-$(printf '%s' "$CLAUDE_ORG" | tr '[:upper:]' '[:lower:]').enc"
  fi
  printf '%s' "$f"
}

# Why there is no token file, for the case where token_file failed.
token_org_hint() {
  echo "The Claude Code token is stored per organization; set CLAUDE_ORG first," >&2
  echo "e.g.  CLAUDE_ORG=acme claude-box-dotnet seal token \"$WORKSPACE\"" >&2
  if [ -f "$(project_secret_dir)/claude-token.enc" ]; then
    echo "(An older org-less claude-token.enc exists in $(project_secret_dir);" >&2
    echo " rename it to claude-token-<org>.enc to keep using it.)" >&2
  fi
}

# Other projects' token files for the SAME organization, one per line (copying a
# token across organizations would log the project in as the wrong account).
other_token_files() {
  local f own
  [ -n "$CLAUDE_ORG" ] || return 0
  own="$(token_file || true)"
  for f in "$CONFIG_DIR"/projects/*/claude-token-"$(printf '%s' "$CLAUDE_ORG" | tr '[:upper:]' '[:lower:]')".enc; do
    [ -f "$f" ] && [ "$f" != "$own" ] && printf '%s\n' "$f"
  done
  return 0
}

# Every token file of every project and organization, for passphrase reuse.
all_token_files() {
  local f
  for f in "$CONFIG_DIR"/projects/*/claude-token-*.enc; do
    [ -f "$f" ] && printf '%s\n' "$f"
  done
  return 0
}

# Remember which directory a project's secret dir belongs to, so the "copy from
# another project" list can show something readable.
note_workspace() {
  local f="$1"
  case "$f" in "$CONFIG_DIR"/projects/*) printf '%s\n' "$WORKSPACE" > "$(dirname "$f")/workspace" ;; esac
}

# Offered when a project has no token and we are creating its container (the token
# is REQUIRED): copy another project's token file or enter a new one. Returns 0 only
# when a token file now exists for this project. Without a terminal it just says what
# to run; `start` then refuses to continue.
offer_token_setup() {
  local target f choice i=0 labels=() files=()
  target="$(token_file)" || { token_org_hint; return 1; }
  if ! tty_dev >/dev/null 2>&1; then
    echo "No Claude Code token is stored for this project and organization; store one with:" >&2
    echo "  CLAUDE_ORG=$CLAUDE_ORG claude-box-dotnet seal token \"$WORKSPACE\"" >&2
    return 1
  fi
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    files+=("$f")
    labels+=("$(cat "$(dirname "$f")/workspace" 2>/dev/null || basename "$(dirname "$f")")")
  done < <(other_token_files)

  while :; do
    {
      echo "No Claude Code token is stored for this project ($WORKSPACE), org $CLAUDE_ORG; one is required."
      for i in "${!files[@]}"; do
        echo "  [$((i + 1))] copy the token from ${labels[$i]}"
      done
      echo "  [s] enter a new token for this project"
      echo "  [q] cancel"
    } >&2
    read_prompt "Choice: " choice shown || return 1
    case "$choice" in
      s|S) cmd_seal token "$WORKSPACE" && break || return 1 ;;
      q|Q) return 1 ;;
      ''|*[!0-9]*) echo "Unrecognized choice." >&2 ;;
      *)
        if [ "$choice" -ge 1 ] && [ "$choice" -le "${#files[@]}" ]; then
          mkdir -p "$(dirname "$target")" && chmod 700 "$(dirname "$target")" 2>/dev/null || true
          ( umask 077; cp "${files[$((choice - 1))]}" "$target" )
          note_workspace "$target"
          echo "Copied the token from ${labels[$((choice - 1))]}." >&2
          break
        fi
        echo "Unrecognized choice." >&2 ;;
    esac
  done
  [ -f "$target" ]
}

# Where prompts are read from: /dev/tty when usable, else stdin when it is a
# terminal (some Windows shells, e.g. Git Bash under winpty, have no /dev/tty).
tty_dev() {
  if { : </dev/tty; } 2>/dev/null; then echo /dev/tty
  elif [ -t 0 ]; then echo /dev/stdin
  else return 1
  fi
}

# Prompt on the terminal and store the reply in the named variable. Whitespace is
# left for the caller to strip. Args: <prompt> <variable name> <hidden|shown>
read_prompt() {
  local tty _line=""
  tty="$(tty_dev)" || { echo "ERROR: no terminal available to prompt for: $1" >&2; return 1; }
  printf '%s' "$1" >&2
  if [ "$3" = hidden ]; then
    IFS= read -rs _line <"$tty" || { printf '\n' >&2; return 1; }
    printf '\n' >&2
  else
    IFS= read -r _line <"$tty" || return 1
  fi
  printf -v "$2" '%s' "$_line"
}
read_hidden() { read_prompt "$1" "$2" hidden; }

# The passphrase for the encrypted files, asked for ONCE per command and reused.
# Non-interactive override: CLAUDE_SECRETS_PASSPHRASE_FILE, then
# CLAUDE_SECRETS_PASSPHRASE; otherwise the user is prompted.
SECRETS_PASSPHRASE=""
PASSPHRASE_PROMPTED=0
get_passphrase() {
  [ -z "$SECRETS_PASSPHRASE" ] || return 0
  if [ -n "${CLAUDE_SECRETS_PASSPHRASE_FILE:-}" ]; then
    SECRETS_PASSPHRASE="$(head -n1 "$CLAUDE_SECRETS_PASSPHRASE_FILE" 2>/dev/null | tr -d '\r')"
  elif [ -n "${CLAUDE_SECRETS_PASSPHRASE:-}" ]; then
    SECRETS_PASSPHRASE="$CLAUDE_SECRETS_PASSPHRASE"
  else
    read_hidden "Passphrase for the encrypted secrets: " SECRETS_PASSPHRASE || return 1
    PASSPHRASE_PROMPTED=1
  fi
  [ -n "$SECRETS_PASSPHRASE" ]
}

# Decrypt a file into the named variable. Args: <file> <variable name>.
# Deliberately NOT a $(...) function: the passphrase cache must survive in this
# shell, or every secret would prompt again. The passphrase goes to openssl
# through its environment (-pass env:), never as an argument visible in `ps`.
# A passphrase typed at the prompt gets 3 tries; one from a file/variable, 1.
openssl_read() {
  local file="$1" out tries=0
  [ -f "$file" ] || return 1
  command -v openssl >/dev/null 2>&1 || { echo "WARNING: 'openssl' is not installed." >&2; return 1; }
  while :; do
    get_passphrase || return 1
    tries=$((tries + 1))
    if out="$(OPENSSL_PASS="$SECRETS_PASSPHRASE" openssl "${OPENSSL_ARGS[@]}" -d -in "$file" 2>/dev/null)"; then
      printf -v "$2" '%s' "$out"
      return 0
    fi
    SECRETS_PASSPHRASE=""
    if [ "$PASSPHRASE_PROMPTED" = 1 ] && [ "$tries" -lt 3 ]; then
      echo "Wrong passphrase for $(basename "$file"); try again." >&2
    else
      return 1
    fi
  done
}

# Resolve a long-lived Claude OAuth token so login survives container recreation.
# The token is never stored in this repo; it is read on the HOST (1Password or an
# openssl-encrypted file, per SECRET_PROVIDER) and only the value is passed in.
#
# Precedence, most specific first:
#   1. an org-scoped source (${CLAUDE_ORG}_CLAUDE_TOKEN_OP_REF, or the org's
#      token file) — naming one is a deliberate statement about WHICH account
#      this project uses, so it outranks whatever is in the ambient environment.
#   2. CLAUDE_CODE_OAUTH_TOKEN already exported — the manual escape hatch.
#   3. the unprefixed source (CLAUDE_TOKEN_OP_REF, or the default token file).
# The source actually used is always printed, and an ambiguous setup says so, so
# you are never left guessing which account a container logged in as.
resolve_token() {
  local src="" org_src="" ambient="${CLAUDE_CODE_OAUTH_TOKEN:-}"

  if [ "$PROVIDER" = openssl ]; then
    if ! src="$(token_file)"; then
      # No CLAUDE_ORG, so there is no file to look for. Only worth saying so when
      # we are about to create the container and nothing else supplies a token.
      src=""
      if [ -z "$ambient" ] && ! docker container inspect "$NAME" >/dev/null 2>&1; then
        token_org_hint
      fi
    elif [ ! -f "$src" ]; then
      src=""
      # Only worth asking when we are about to create the container (that is the
      # only time the token is used) and nothing else supplies one. The token is
      # required, so `start` refuses to continue without it.
      if [ -z "$ambient" ] && ! docker container inspect "$NAME" >/dev/null 2>&1 \
         && offer_token_setup; then
        src="$(token_file)"
      fi
    fi
    org_src="$src"   # a per-project token is deliberate, so it outranks an exported one
  else
    if [ -n "$CLAUDE_ORG" ]; then
      org_src="$(first_env "$(org_var CLAUDE_TOKEN_OP_REF)" || true)"
    fi
    src="$org_src"
    [ -n "$src" ] || src="$(first_env CLAUDE_TOKEN_OP_REF || true)"
  fi

  if [ -n "$org_src" ] && [ -n "$ambient" ]; then
    echo "NOTE: CLAUDE_CODE_OAUTH_TOKEN is already exported, but"
    echo "      a more specific token is configured for this project ($src) —"
    echo "      using that one."
    CLAUDE_CODE_OAUTH_TOKEN=""
  elif [ -n "$ambient" ]; then
    echo "Using the Claude token already exported as CLAUDE_CODE_OAUTH_TOKEN."
    return 0
  fi

  if [ -z "$src" ]; then
    return 0
  fi

  if [ "$PROVIDER" = openssl ]; then
    if openssl_read "$src" CLAUDE_CODE_OAUTH_TOKEN; then
      CLAUDE_CODE_OAUTH_TOKEN="$(printf '%s' "$CLAUDE_CODE_OAUTH_TOKEN" | tr -d '[:space:]')"
    fi
    if [ -z "$CLAUDE_CODE_OAUTH_TOKEN" ]; then
      echo "WARNING: could not decrypt $src (wrong passphrase?);" >&2
      return 0
    fi
    export CLAUDE_CODE_OAUTH_TOKEN
    echo "Resolved Claude token from the encrypted file ($src)."
    return 0
  fi

  if ! command -v op >/dev/null 2>&1; then
    echo "WARNING: a Claude token reference is set but the 'op' CLI isn't installed;" >&2
    return 0
  fi
  if ! CLAUDE_CODE_OAUTH_TOKEN="$(op_read "$src")"; then
    CLAUDE_CODE_OAUTH_TOKEN=""
    echo "WARNING: could not read $src from 1Password;" >&2
    return 0
  fi
  export CLAUDE_CODE_OAUTH_TOKEN
  echo "Resolved Claude token from 1Password ($src)."
}

# Resolve the SSH private key that reaches the remote Docker VM. Same posture as
# the Claude token: the key is NEVER committed to this repo and NEVER baked into
# the image — we read it on the HOST (1Password or an openssl-encrypted file, per
# SECRET_PROVIDER) and inject it into the running container.
# 1Password: ${CLAUDE_ORG}_DOCKER_SSH_KEY_OP_REF, then DOCKER_SSH_KEY_OP_REF.
# openssl: ${CLAUDE_ORG}_DOCKER_SSH_KEY_FILE, DOCKER_SSH_KEY_FILE, or the default
# file in the config dir. Either way DOCKER_SSH_KEY set directly skips the provider.
# Sets SSH_KEY, empty when unavailable — callers warn rather than abort, so you
# can still work in a container that just can't reach the remote daemon.
resolve_ssh_key() {
  local ref
  SSH_KEY="${DOCKER_SSH_KEY:-}"
  [ -z "$SSH_KEY" ] || return 0

  if [ "$PROVIDER" = openssl ]; then
    ref="$(ssh_key_file)"
    [ -f "$ref" ] || return 0
    if ! openssl_read "$ref" SSH_KEY || [ -z "$SSH_KEY" ]; then
      SSH_KEY=""
      echo "WARNING: could not decrypt $ref (wrong passphrase?)." >&2
      return 0
    fi
    echo "Resolved remote-Docker SSH key from the encrypted file ($ref)."
    return 0
  fi

  if ! ref="$(first_env "$(org_var DOCKER_SSH_KEY_OP_REF)" DOCKER_SSH_KEY_OP_REF)"; then
    return 0
  fi
  if ! command -v op >/dev/null 2>&1; then
    echo "WARNING: an SSH key reference is set but the 'op' CLI isn't installed." >&2
    return 0
  fi
  if ! SSH_KEY="$(op_read "$ref")"; then
    SSH_KEY=""
    echo "WARNING: could not read $ref from 1Password." >&2
    return 0
  fi
  echo "Resolved remote-Docker SSH key from 1Password ($ref)."
}

# Write the resolved key into the RUNNING container. Deliberate choices:
#   * over STDIN — not `-e` (the value would show up in `docker inspect`) and not
#     as an argument (visible in `ps` on the host while the exec runs).
#   * decoded INSIDE the container, so the plaintext key never lands in a file or
#     a second process on the host.
#   * `umask 077` makes the file 600, which ssh insists on.
# Idempotent, so we re-run it on every start and a recreated container is never
# left keyless.
install_ssh_key() {
  [ -n "${SSH_KEY:-}" ] || return 0

  # The 1Password item stores the key base64-encoded, but DOCKER_SSH_KEY — and
  # any item someone chooses to store verbatim — is raw PEM. Detect which we have
  # instead of forcing one: a raw key always carries a "-----BEGIN ... PRIVATE
  # KEY-----" armour line, which never appears in base64 output.
  local mode=base64
  case "$SSH_KEY" in
    *"-----BEGIN"*) mode=raw ;;
  esac

  # Decode and validate into a TEMP file, and only move it into place once
  # ssh-keygen confirms it parses. Writing straight to ~/.ssh/id_rsa would let a
  # bad secret destroy a key that currently works — and since the image no longer
  # bakes one in, there would be nothing left to fall back to.
  #
  # ssh also rejects a key whose last line has no newline ("invalid format"), and
  # neither `op read` nor base64 guarantees one, so add it when it's missing.
  local rc=0
  printf '%s' "$SSH_KEY" | docker exec -i -u "$CONTAINER_USER" "$NAME" bash -c '
        umask 077
        mkdir -p ~/.ssh
        tmp=~/.ssh/.id_rsa.incoming
        trap "rm -f $tmp" EXIT
        # Strip whitespace before decoding: a stray trailing space or wrapped
        # lines in the 1Password field are common paste artifacts and would
        # otherwise fail the decode. Raw PEM is passed through untouched, since
        # there the newlines are structural.
        if [ "$1" = base64 ]; then
          tr -d "[:space:]" | base64 -d > "$tmp" 2>/dev/null || exit 2
        else
          cat > "$tmp"
        fi
        [ -s "$tmp" ] || exit 3
        [ "$(tail -c1 "$tmp" | wc -l)" -eq 1 ] || printf "\n" >> "$tmp"
        ssh-keygen -l -f "$tmp" >/dev/null 2>&1 || exit 4
        mv "$tmp" ~/.ssh/id_rsa
      ' _ "$mode" || rc=$?

  if [ "$rc" -ne 0 ]; then
    case "$rc" in
      2) echo "WARNING: the SSH key value did not decode as base64." >&2 ;;
      3) echo "WARNING: the SSH key value was empty after decoding." >&2 ;;
      4) echo "WARNING: the SSH key value is not a valid private key." >&2 ;;
      *) echo "WARNING: could not install the SSH key into '$NAME'." >&2 ;;
    esac
    echo "         Any key already in '$NAME' was left untouched." >&2
    return 0
  fi

  local fp
  fp="$(docker exec -u "$CONTAINER_USER" "$NAME" ssh-keygen -l -f /home/$CONTAINER_USER/.ssh/id_rsa 2>/dev/null || echo '?')"
  echo "Installed remote-Docker SSH key into '$NAME': $fp"
}

# Note (not an error) when the container has no usable key: `docker` inside it targets the
# remote VM over SSH, and the failure you'd otherwise get is an opaque auth error
# a long way from the cause.
check_ssh_key() {
  if docker exec -u "$CONTAINER_USER" "$NAME" test -s /home/$CONTAINER_USER/.ssh/id_rsa 2>/dev/null; then
    return 0
  fi
  cat >&2 <<EOF

NOTE: no SSH key in '$NAME', so the remote Docker host
      (ssh://${REMOTE_DOCKER_USER}@${REMOTE_DOCKER_HOST}) is not available for
      automated container testing. This is optional; everything else works.
      To enable it, export $(org_var DOCKER_SSH_KEY_OP_REF) with a 1Password reference,
      or run 'claude-box-dotnet seal ssh-key <file>' and 'provider openssl'
      (see the README, "Remote Docker daemon"), or set DOCKER_SSH_KEY, then
      re-run 'claude-box-dotnet start'.
EOF
}

# Mirror the HOST's git identity into the container. Commits are made inside the
# container (pushes happen on the host), and `git commit` refuses to run without
# a name and an email — a fresh container has neither. Note this is identity, not
# credentials: it confers no ability to reach any git server.
# Override with GIT_USER_NAME / GIT_USER_EMAIL. Otherwise we ask the host's git,
# from inside the project directory, so a repo-local identity wins over the global
# one exactly as it would on the host.
resolve_git_identity() {
  GIT_NAME="${GIT_USER_NAME:-$(git -C "$WORKSPACE" config --get user.name 2>/dev/null || true)}"
  GIT_EMAIL="${GIT_USER_EMAIL:-$(git -C "$WORKSPACE" config --get user.email 2>/dev/null || true)}"
}

# Applied on every start, not just on create: the container's home directory is
# not a named volume, so a recreated container comes up with no identity again.
install_git_identity() {
  if [ -z "${GIT_NAME:-}" ] && [ -z "${GIT_EMAIL:-}" ]; then
    cat >&2 <<EOF
WARNING: no git identity found on the host, so 'git commit' will fail inside
         '$NAME'. Set user.name/user.email in your host git config, or export
         GIT_USER_NAME and GIT_USER_EMAIL, then re-run 'claude-box-dotnet start'.
EOF
    return 0
  fi
  if [ -n "${GIT_NAME:-}" ]; then
    docker exec -u "$CONTAINER_USER" "$NAME" git config --global user.name "$GIT_NAME" \
      || echo "WARNING: could not set git user.name in '$NAME'." >&2
  fi
  if [ -n "${GIT_EMAIL:-}" ]; then
    docker exec -u "$CONTAINER_USER" "$NAME" git config --global user.email "$GIT_EMAIL" \
      || echo "WARNING: could not set git user.email in '$NAME'." >&2
  fi
  echo "Git identity in '$NAME': ${GIT_NAME:-<unset>} <${GIT_EMAIL:-unset}>"
}

# Show a connection string with its password masked. Users override the throwaway
# default with real credentials, and the status report lands in terminals and logs.
redact_conn() {
  printf '%s' "$1" | sed -E 's/([Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Ww][Dd])=[^;]*/\1=***/g'
}

# Print the PROJECT_CODE_NAME the container was CREATED with, empty if it has
# none. A container's environment is fixed at create time — `docker start` cannot
# add a variable — so a container that predates this feature (or was started with a
# different code name) keeps the old prompt until it is recreated. Reading it back
# from the container makes that visible here instead of a mystery after attaching.
# Read via inspect, not `docker exec printenv`, so it also works while stopped.
container_code_name() {
  docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$NAME" 2>/dev/null \
    | sed -n 's/^PROJECT_CODE_NAME=//p'
}

# --- commands ---------------------------------------------------------------

# Show or set the secrets provider. Like `seal`, it applies to a PROJECT by default
# and `--user` selects the per-user default that projects without a setting use.
#   provider                    show the effective provider for the current project
#   provider NAME [DIR]         set it for the project (1password | openssl)
#   provider unset [DIR]        remove the project's setting (falls back to the default)
#   provider NAME --user        set the per-user default
#   provider unset --user       remove the per-user default (back to 1password)
#   provider --user             show the per-user default
# Both settings live outside every repo, under ~/.config/claude-box.
cmd_provider() {
  local want="" scope=project dir="" a lc
  for a in "$@"; do
    [ -n "$a" ] || continue
    lc="$(printf '%s' "$a" | tr '[:upper:]' '[:lower:]')"
    case "$lc" in
      --user) scope=user ;;
      1password|openssl|unset) want="$lc" ;;
      *) dir="$a" ;;
    esac
  done
  if [ -n "$dir" ] && [ "$scope" = user ]; then
    echo "ERROR: --user is per user; it takes no directory." >&2
    return 2
  fi

  if [ -z "$want" ]; then
    if [ "$scope" = user ]; then
      echo "Per-user default provider: $(config_get SECRET_PROVIDER || echo '1password (built-in; none set)')"
      return 0
    fi
    resolve_target "$dir"
    load_provider
    echo "Secrets provider: $PROVIDER"
    echo "  (from $PROVIDER_SOURCE)"
    return 0
  fi

  local file
  if [ "$scope" = project ]; then
    resolve_target "$dir"
    file="$(project_config_file)"
    mkdir -p "$(dirname "$file")" && chmod 700 "$CONFIG_DIR" "$(dirname "$file")" 2>/dev/null || true
  else
    file="$CONFIG_FILE"
    mkdir -p "$CONFIG_DIR" && chmod 700 "$CONFIG_DIR"
  fi
  local tmp
  tmp="$(umask 077; mktemp "$(dirname "$file")/.config.XXXXXX")"
  { [ ! -f "$file" ] || grep -v '^SECRET_PROVIDER=' "$file" || true
    [ "$want" = unset ] || printf 'SECRET_PROVIDER=%s\n' "$want"; } > "$tmp"
  mv "$tmp" "$file"
  if [ "$scope" = project ]; then
    note_workspace "$file"
    if [ "$want" = unset ]; then
      echo "Removed the provider setting for $WORKSPACE (it uses the per-user default again)."
    else
      echo "Secrets provider for $WORKSPACE set to '$want' ($file)."
    fi
  elif [ "$want" = unset ]; then
    echo "Removed the per-user default provider (projects without a setting use 1password)."
  else
    echo "Default secrets provider (per user) set to '$want' ($file)."
  fi
}

# Create an openssl-encrypted secret file for the openssl provider.
#   seal token [DIR]             type this project's Claude Code token for the org in
#                                CLAUDE_ORG (required; hidden input; whitespace stripped)
#   seal ssh-key FILE [DIR]      encrypt an existing Docker-host private key for this
#                                project; with --user instead of DIR, the per-user
#                                default used by projects that have none of their own
# The secret is never taken as an argument (it would land in shell history and
# `ps`). The result is written 600 into the config dir (outside every project)
# after a decrypt round-trip check, so a typo'd passphrase can't produce an
# unreadable file. Uses `return`, not `exit`, so `start` can call it inline.
cmd_seal() {
  local kind="${1:-}" arg="${2:-}" dir="" scope=project target secret="" pass1="" pass2="" f ref=""
  case "$kind" in
    token)   dir="$arg" ;;
    ssh-key) dir="${3:-}"
             if [ "$dir" = --user ]; then scope=user; dir=""; fi
             [ -f "$arg" ] || { echo "Usage: claude-box-dotnet seal ssh-key <private-key-file> [DIR | --user]" >&2; return 2; } ;;
    *) echo "Usage: claude-box-dotnet seal token [DIR] | seal ssh-key <private-key-file> [DIR | --user]" >&2; return 2 ;;
  esac
  resolve_target "$dir"
  if [ "$kind" = token ]; then
    target="$(token_file)" || { echo "ERROR: no organization set." >&2; token_org_hint; return 1; }
  elif [ "$scope" = user ]; then target="$(ssh_key_user_file)"
  else target="$(first_env "$(org_var DOCKER_SSH_KEY_FILE)" DOCKER_SSH_KEY_FILE || ssh_key_project_file)"; fi
  command -v openssl >/dev/null 2>&1 || { echo "ERROR: 'openssl' is not installed." >&2; return 1; }

  if [ -e "$target" ]; then
    local yn=""
    read_prompt "$target already exists. Overwrite? [y/N] " yn shown || return 1
    case "$yn" in y|Y|yes) ;; *) echo "Aborted." >&2; return 1 ;; esac
  fi

  if [ "$kind" = token ]; then
    read_hidden "Claude Code token for $WORKSPACE${CLAUDE_ORG:+ (org $CLAUDE_ORG)} (input hidden): " secret || return 1
    secret="$(printf '%s' "$secret" | tr -d '[:space:]')"
  else
    secret="$(tr -d '\r' < "$arg")"
  fi
  [ -n "$secret" ] || { echo "ERROR: the secret is empty." >&2; return 1; }

  # `start` asks for ONE passphrase and uses it for every file, so reuse the
  # passphrase of an existing one (a Docker-host key, this project's token, or
  # another project's token) instead of inventing a new one.
  for f in "$(ssh_key_user_file)" "$(ssh_key_project_file)" $(all_token_files); do
    if [ -f "$f" ] && [ "$f" != "$target" ]; then ref="$f"; break; fi
  done

  if [ -n "${CLAUDE_SECRETS_PASSPHRASE_FILE:-}${CLAUDE_SECRETS_PASSPHRASE:-}" ]; then
    get_passphrase || { echo "ERROR: could not read the passphrase." >&2; return 1; }
  elif [ -n "$ref" ]; then
    local ref_plain=""
    echo "Using the passphrase of the existing $(basename "$ref") so one prompt unlocks everything." >&2
    if ! openssl_read "$ref" ref_plain; then
      local yn=""
      read_prompt 'That passphrase does not match; use a different one for the new file? [y/N] ' yn shown || return 1
      case "$yn" in y|Y|yes) ;; *) echo "Aborted." >&2; return 1 ;; esac
      read_hidden "New passphrase: " pass1 || return 1
      read_hidden "Repeat passphrase: " pass2 || return 1
      [ "$pass1" = "$pass2" ] && [ -n "$pass1" ] || { echo "ERROR: passphrases empty or not matching." >&2; return 1; }
      SECRETS_PASSPHRASE="$pass1"
      echo "NOTE: the files use different passphrases; 'start' will ask for each." >&2
    fi
  else
    read_hidden "New passphrase: " pass1 || return 1
    read_hidden "Repeat passphrase: " pass2 || return 1
    [ "$pass1" = "$pass2" ] || { echo "ERROR: passphrases do not match." >&2; return 1; }
    [ -n "$pass1" ] || { echo "ERROR: the passphrase is empty." >&2; return 1; }
    SECRETS_PASSPHRASE="$pass1"
  fi

  mkdir -p "$(dirname "$target")" && chmod 700 "$CONFIG_DIR" "$(dirname "$target")" 2>/dev/null || true
  local tmp back
  tmp="$(umask 077; mktemp "$(dirname "$target")/.seal.XXXXXX")"
  if ! printf '%s' "$secret" | OPENSSL_PASS="$SECRETS_PASSPHRASE" openssl "${OPENSSL_ARGS[@]}" -out "$tmp" 2>/dev/null; then
    rm -f "$tmp"
    echo "ERROR: openssl could not encrypt (does your openssl support -pbkdf2?)." >&2
    return 1
  fi
  back="$(OPENSSL_PASS="$SECRETS_PASSPHRASE" openssl "${OPENSSL_ARGS[@]}" -d -in "$tmp" 2>/dev/null || true)"
  if [ "$back" != "$secret" ]; then
    rm -f "$tmp"
    echo "ERROR: the encrypted file did not decrypt back to the input; nothing written." >&2
    return 1
  fi
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$target"
  note_workspace "$target"
  echo "Sealed $kind -> $target"
  echo "Use it with: claude-box-dotnet provider openssl"
}

cmd_start() {
  resolve_target "${1:-}"
  load_provider

  # Secrets (and so the openssl passphrase prompt) are only needed to create the
  # container (token) or to install a missing SSH key. A container that is already
  # running with its key in place needs neither, so don't ask.
  if [ "$(docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null || true)" = true ] \
     && docker exec -u "$CONTAINER_USER" "$NAME" test -s "/home/$CONTAINER_USER/.ssh/id_rsa" 2>/dev/null; then
    echo "Container '$NAME' is already running with its SSH key; not reading secrets."
    SSH_KEY=""
  else
    resolve_token
    resolve_ssh_key
  fi
  resolve_git_identity

  # Fixed host port if PORT is set, otherwise an auto-assigned (ephemeral) one so
  # multiple projects can run simultaneously without colliding on :8080.
  if [ -n "${PORT:-}" ]; then
    PORT_ARG=(-p "${PORT}:8080")
  else
    PORT_ARG=(-p 8080)
  fi

  # This tool runs containers and never builds. A missing image is a hard error
  # naming the builder, so the two responsibilities stay cleanly separated.
  if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "ERROR: image '$IMAGE' does not exist. Build it with: $BUILD_SCRIPT" >&2
    exit 1
  fi

  # The Claude Code token is REQUIRED to create the container: without it Claude
  # can't log in and the container is unusable. (An already-created container has
  # its token baked in, so restarting one needs nothing here.)
  if [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && ! docker container inspect "$NAME" >/dev/null 2>&1; then
    cat >&2 <<MSG
ERROR: no Claude Code token, and the container can't be created without one.
       1. On the host run:  claude setup-token   (prints a long-lived token)
       2. Store it, then re-run 'claude-box-dotnet start':
            openssl:   claude-box-dotnet provider openssl
                       CLAUDE_ORG=<org> claude-box-dotnet seal token "$WORKSPACE"
            1Password: export $(org_var CLAUDE_TOKEN_OP_REF)="op://<vault>/<item>/<field>"
            or export CLAUDE_CODE_OAUTH_TOKEN directly.
MSG
    exit 1
  fi

  # Only pass the token when we actually have one. An empty -e still CREATES the
  # variable inside the container, and an empty CLAUDE_CODE_OAUTH_TOKEN is a
  # different thing to Claude than an absent one.
  TOKEN_ARG=()
  if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
    TOKEN_ARG=(-e CLAUDE_CODE_OAUTH_TOKEN="$CLAUDE_CODE_OAUTH_TOKEN")
  fi

  if docker container inspect "$NAME" >/dev/null 2>&1; then
    # Guard against CLAUDE_ORG drift. The container name comes from the project
    # PATH only, so the same directory started under a different org would
    # silently reuse the previous org's credentials volume and baked-in token env
    # — the exact confusion the namespacing exists to prevent. Containers created
    # before this label existed report "<no value>", which we treat as "no org".
    EXISTING_ORG="$(docker inspect -f '{{index .Config.Labels "claude-box.org"}}' "$NAME" 2>/dev/null || true)"
    [ "$EXISTING_ORG" != "<no value>" ] || EXISTING_ORG=""
    if [ "$EXISTING_ORG" != "$CLAUDE_ORG" ]; then
      cat >&2 <<EOF
ERROR: container '$NAME' was created with
       CLAUDE_ORG='${EXISTING_ORG:-<none>}', but you are running with
       CLAUDE_ORG='${CLAUDE_ORG:-<none>}'. Reusing it would mount the other org's
       Claude credentials. Recreate it for this org:

         claude-box-dotnet rm    "$WORKSPACE"
         claude-box-dotnet start "$WORKSPACE"
EOF
      exit 1
    fi
    echo "Reusing existing container '$NAME' (starting it)..."
    docker start "$NAME" >/dev/null
  else
    echo "Creating container '$NAME' for $WORKSPACE ..."
    docker run -d \
      --name "$NAME" \
      --hostname "$NAME" \
      --label "claude-box.org=${CLAUDE_ORG}" \
      --add-host=host.docker.internal:host-gateway \
      --cap-add=NET_ADMIN --cap-add=NET_RAW \
      -v "$WORKSPACE":/workspace \
      -v "$CONFIG_VOLUME":/home/$CONTAINER_USER/.claude \
      -v "claude-dotnet-sessions-${HASH}":/home/$CONTAINER_USER/.claude/projects \
      -v "claude-dotnet-bash-history-${HASH}":/commandhistory \
      -v claude-nuget-cache:/home/$CONTAINER_USER/.nuget/packages \
      -v claude-pre-commit-cache:/home/$CONTAINER_USER/.cache/pre-commit \
      -e PRE_COMMIT_HOME=/home/$CONTAINER_USER/.cache/pre-commit \
      -e ConnectionStrings__Default="$DB_CONNECTION_STRING" \
      -e PROJECT_CODE_NAME="$PROJECT_CODE_NAME" \
      "${TOKEN_ARG[@]}" \
      -e REMOTE_DOCKER_USER="$REMOTE_DOCKER_USER" \
      -e REMOTE_DOCKER_HOST="$REMOTE_DOCKER_HOST" \
      -e DOCKER_HOST="ssh://${REMOTE_DOCKER_USER}@${REMOTE_DOCKER_HOST}" \
      "${PORT_ARG[@]}" \
      "$IMAGE" >/dev/null

    # The per-project sessions volume is a FRESH named volume, so it mounts as
    # root:root — but Claude runs as the container user and must write session
    # transcripts there. Same for the NuGet and pre-commit caches. Fix ownership
    # once, right after create, or history is silently lost and restore fails.
    docker exec -u root "$NAME" chown "$CONTAINER_USER:$CONTAINER_USER" \
      /home/$CONTAINER_USER/.claude/projects \
      /home/$CONTAINER_USER/.nuget/packages \
      /home/$CONTAINER_USER/.cache/pre-commit

    # If the mounted project has a solution or project file, restore it now (into
    # the NuGet cache volume and the image's ArtifactsPath, both OUTSIDE the mount —
    # nothing leaks into your project). Honor existing lockfiles if present;
    # otherwise create them. Never abort the start on failure.
    if compgen -G "$WORKSPACE/*.sln" >/dev/null \
       || compgen -G "$WORKSPACE/*.slnx" >/dev/null \
       || compgen -G "$WORKSPACE/*.csproj" >/dev/null; then
      echo "Found a solution/project file; running 'dotnet restore' inside the container..."
      docker exec "$NAME" bash -lc \
        'if find . -maxdepth 2 -name packages.lock.json | grep -q .; then dotnet restore --locked-mode; else dotnet restore; fi' \
        || echo "  (dotnet restore failed — run it yourself after attaching)"
    fi
  fi

  # Inject the key on EVERY start, not just on create: it lives in the container's
  # writable layer, so a recreated container would otherwise come up keyless.
  install_ssh_key
  check_ssh_key
  install_git_identity

  # Report the actual host port mapped to container :8080.
  MAPPED="$(docker port "$NAME" 8080 2>/dev/null | head -1 || true)"

  ACTUAL_CODE_NAME="$(container_code_name)"
  if [ -n "$ACTUAL_CODE_NAME" ]; then
    CODE_NAME_REPORT="$ACTUAL_CODE_NAME"
  else
    CODE_NAME_REPORT="<none> (prompt shows '$CONTAINER_USER'; 'claude-box-dotnet rm' + 'start' applies '$PROJECT_CODE_NAME')"
  fi

  cat <<EOF

Container '$NAME' is running.
  workspace : $WORKSPACE  ->  /workspace
  code name : $CODE_NAME_REPORT  (shell prompt)
  database  : $(redact_conn "$DB_CONNECTION_STRING")
  port      : ${MAPPED:-<none>}  ->  container :8080
  org       : ${CLAUDE_ORG:-<none>}  (Claude credentials volume: $CONFIG_VOLUME)

Next:
  1. VS Code -> "Dev Containers: Attach to Running Container" -> $NAME
  2. Start a Claude conversation in the extension.

Stop when done:  claude-box-dotnet stop $WORKSPACE
EOF
}

cmd_stop() {
  resolve_target "${1:-}"
  if ! docker container inspect "$NAME" >/dev/null 2>&1; then
    echo "No container for this project ($NAME)." >&2
    exit 1
  fi
  echo "Stopping '$NAME' ..."
  docker stop "$NAME" >/dev/null
  echo "Stopped."
}

cmd_rm() {
  resolve_target "${1:-}"
  if ! docker container inspect "$NAME" >/dev/null 2>&1; then
    echo "No container for this project ($NAME)." >&2
    exit 1
  fi
  echo "Removing '$NAME' (stopping if running) ..."
  docker rm -f "$NAME" >/dev/null
  echo "Removed. Next 'claude-box-dotnet start' will create a fresh one (picking up any rebuilt image)."
}

cmd_shell() {
  resolve_target "${1:-}"
  if ! docker container inspect "$NAME" >/dev/null 2>&1; then
    echo "No container for this project ($NAME). Start it with: claude-box-dotnet start $WORKSPACE" >&2
    exit 1
  fi
  # Start it if it exists but isn't running, then open an interactive login shell.
  if [ "$(docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" != "true" ]; then
    echo "Container '$NAME' is stopped; starting it ..."
    docker start "$NAME" >/dev/null
  fi
  exec docker exec -it -w /workspace "$NAME" bash -l
}

cmd_info() {
  resolve_target "${1:-}"
  if ! docker container inspect "$NAME" >/dev/null 2>&1; then
    cat <<EOF
Container   : $NAME
Status      : absent (not created)
Workspace   : $WORKSPACE
Start it with:  claude-box-dotnet start $WORKSPACE
EOF
    return 0
  fi

  STATUS="$(docker inspect -f '{{.State.Status}}' "$NAME" 2>/dev/null || echo unknown)"
  STARTED="$(docker inspect -f '{{.State.StartedAt}}' "$NAME" 2>/dev/null || echo '')"
  IMG="$(docker inspect -f '{{.Config.Image}}' "$NAME" 2>/dev/null || echo '')"
  MAPPED="$(docker port "$NAME" 8080 2>/dev/null | head -1 || true)"
  # The org the container was CREATED with, which is what its mounted credentials
  # actually belong to — not necessarily the CLAUDE_ORG in your current shell.
  CONTAINER_ORG="$(docker inspect -f '{{index .Config.Labels "claude-box.org"}}' "$NAME" 2>/dev/null || true)"
  [ "$CONTAINER_ORG" != "<no value>" ] || CONTAINER_ORG=""
  CONTAINER_CODE_NAME="$(container_code_name)"

  cat <<EOF
Container   : $NAME
Status      : $STATUS (since $STARTED)
Image       : $IMG
Workspace   : $WORKSPACE  ->  /workspace
Code name   : ${CONTAINER_CODE_NAME:-<none>} (created with; shown in the shell prompt)
Port        : ${MAPPED:-<none>}  ->  container :8080
Org         : ${CONTAINER_ORG:-<none>} (created with)
Shell org   : ${CLAUDE_ORG:-<none>} (CLAUDE_ORG in this shell)
EOF
}

# --- dispatch ---------------------------------------------------------------

[ $# -ge 1 ] || usage 2
CMD="$1"; shift || true
case "$CMD" in
  start)   cmd_start   "${1:-}" ;;
  stop)    cmd_stop    "${1:-}" ;;
  rm)      cmd_rm      "${1:-}" ;;
  shell)   cmd_shell   "${1:-}" ;;
  info)    cmd_info    "${1:-}" ;;
  provider) cmd_provider "$@" ;;
  seal)    cmd_seal    "${1:-}" "${2:-}" "${3:-}" ;;
  -h|--help|help) usage 0 ;;
  *) echo "Unknown command: $CMD" >&2; usage 2 ;;
esac
